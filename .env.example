# Supabase project (provided automatically by the v0 / Vercel Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
# Used by public RSVP/wish routes and the admin token routes; every table has RLS enabled
# with no anonymous policies, so this key never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical site URL used to build invitation links in the admin panel.
# Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=
